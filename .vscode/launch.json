        {
            "name": "yoco train debug",
            "type": "debugpy",
            "request": "launch",
            "program": "main_training_llama_yoco.py",
            "env":{
                "NCCL_IB_HCA":"mlx5_0,mlx5_3",
                "NCCL_IB_QPS_PER_CONNECTION":"8",
                "NCCL_IB_SPLIT_DATA_ON_QPS":"0",
                "NCCL_IB_PCI_RELAXED_ORDERING":"1",
                "NCCL_IB_GID_INDEX":"3",
                "NCCL_SOCKET_IFNAME":"eth0",
                "CUDA_VISIBLE_DEVICES":"0",//,1,2,3,4,5,6,7",
                "NCCL_ALGO":"Ring",
                "NCCL_IGNORE_CPU_AFFINITY":"1",
                "NCCL_DEBUG_SUBSYS":"INIT,GRAPH,ENV,TUNING",
                "NCCL_IB_DISABLE":"0",
                "NCCL_SOCKET_NTHREADS":"2",
                "NCCL_CROSS_NIC":"0",
                "NCCL_DEBUG":"WARN",
                "OMP_NUM_THREADS":"16",
                "NCCL_BUFFSIZE":"8388608",
                "LOCAL_RANK":"0",
                "WORLD_SIZE":"1",

            },
            "cwd": "/app/fms-fsdp-fork/", //"~/projects/fms-fsdp-fork/",
            "justMyCode": false,
            "args": [
                "--model_variant","llama_1b",
                "--use_dummy_dataset","False",
                "--data_path","/datasets",
                "--data_meta_path","/gpfs/datasets_metadata",
                "--file_type","auto",
