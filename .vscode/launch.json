                "--tokenizer_path","/datasets/tokenizers/llama3",
                "--seq_length","4096",
                "--vocab_size","128256",
                "--bos_token","None",
                "--eos_token","128000",
                "--logical_shards","8",
                "--ckpt_save_path","/gpfs/cliu/temp",
                "--ckpt_load_path","/gpfs/cliu/temp",
                "--fsdp_activation_checkpointing","True",
                "--selective_checkpointing","1",
                "--sharding_strategy","hsdp",
                "--low_cpu_fsdp","False",
                "--batch_size","8",
                "--num_steps","40_000",
                "--learning_rate","3e-4",
                "--report_interval","100",
                "--checkpoint_interval","20_000",
                "--training_stage","cosine",
                "--use_profiler","False", // was "True"
                "--use_torch_compile","False",
                "--doc_cutoff","2_000_000",
                "--seed","12345",
                "--target_doclen","10",
                "--filter_exp","5",
                "--slice_rate","0",
                "--datasets","starcoder-codepile-v02-L1-noGPL,webhose_en,uspto_en,DMMathematics_split,arxiv_en,financial_research_papers,ieee_en,paperswithcode,peS2o,wikipedia_en,stackexchange,Openwebmath_filtered,Algebraic-stack,doabooks_en,LOCbooks,freelaw,pubmedcentral,EDGAR,Earnings_call_transcript,FIDC,sec_filing,FineWebv1.1",
                "--weights","19,2,1,0.67,0.67,0.67,0.67,0.67,0.67,0.5,0.5,0.5,0.5,0.5,0.5,1,1,0.375,0.375,0.375,0.375,67.5",
                "--tracker","wandb", //disable this for debug
                "--tracker_dir","/gpfs/cliu",
                "--tracker_project_name","example-project",
                "--tracker_run_id","test",
            ]
        },
        //torchrun --nnodes=${WORLD_SIZE} --node_rank=${RANK} --nproc_per_node=8 --rdzv_id=101 --rdzv_endpoint="${MASTER_ADDR}:${MASTER_PORT}"        

